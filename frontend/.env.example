# For local (non-Docker) development only.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# When running via Docker Compose these values are injected at BUILD time
# from the root .env (docker compose reads ./.env for interpolation) —
# see .env.example in the project root. This file is ignored by the image.