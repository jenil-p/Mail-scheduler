# ─────────────────────────────────────────────────────────────────────────────
# When running via Docker Compose, these values are set automatically by
# docker-compose.yml and will override anything here:
#   PORT=4000, NODE_ENV=production,
#   DATABASE_URL -> postgresql://sendly:sendly_pass@postgres:5432/sendly
#   REDIS_HOST=redis, REDIS_PORT=6379
# Only fill in the secrets below (Google OAuth + JWT) and the host-facing URLs.
# ─────────────────────────────────────────────────────────────────────────────
[TEMPLATE]
PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://sendly:sendly_pass@localhost:5432/sendly?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

JWT_SECRET=your-super-secret-jwt-key

FRONTEND_URL=http://localhost:3000

WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# ─────────────────────────────────────────────────────────────────────────────
# AI personalization (all optional)
#
# The feature is off by default: with AI_PERSONALIZATION_ENABLED=false nothing
# new starts and campaigns with aiEnabled=false behave exactly as before.
#
# LLM_PROVIDER is either:
#   mock    deterministic, offline, no API key, no cost — the default, and what
#           local development and every test use
#   gemini  the Google Gemini API (free tier), via Google AI Studio
#
# Every value below is validated at startup; a bad value stops the process with a
# message naming the offending variable.
#
# ⚠ Data handling on the free tier: Gemini's "Unpaid Services" may use the
# content you submit (and the generated responses) to improve and develop Google
# products and services, and human reviewers may read API input/output. Never
# point development or demo campaigns at real personal data — use fake data
# (see the README section "AI personalization and data handling").
# ─────────────────────────────────────────────────────────────────────────────
AI_PERSONALIZATION_ENABLED=false
LLM_PROVIDER=

# Required when LLM_PROVIDER=gemini:
#   LLM_MODEL             the model id you picked in AI Studio (part of the prompt fingerprint)
#   LLM_API_KEY           server-side only; never logged and never committed
#   LLM_RATE_LIMIT_PER_DAY  your model's daily request limit, copied from the AI Studio
#                         rate-limit page. Not defaulted here on purpose: Google changes
#                         these numbers and they differ per model.
# LLM_MODEL=your_gemini_model_id
# LLM_API_KEY=your_gemini_api_key
# LLM_RATE_LIMIT_PER_DAY=200

# Limits and thresholds (shown with their built-in defaults):
# LLM_TIMEOUT_MS=15000              per-call timeout
# LLM_MAX_RETRIES=4                 transient failures (network, timeout, 429, 5xx)
# LLM_MAX_PARSE_RETRIES=2           malformed JSON / schema failures
# LLM_RETRY_BASE_MS=2000            first retry delay; the generate queue jitters it
# LLM_RETRY_MAX_MS=60000            ceiling for that delay
# LLM_MAX_OUTPUT_TOKENS=512         total output allowance per call, THINKING INCLUDED
#                                   (Gemini counts thinking tokens as output tokens, so
#                                   this has to cover reasoning plus the JSON answer)
# LLM_THINKING_BUDGET=0             0 disables thinking; some models require a minimum
#                                   (e.g. 128 on Gemini 2.5 Pro)
# LLM_RATE_LIMIT_PER_MIN=5          sliding-window cap for the provider (free tier is small)
# LLM_DAILY_RESET_TZ=America/Los_Angeles  time zone whose midnight resets the daily counter
# GENERATE_CONCURRENCY=1            generate worker concurrency (free tier is small)
# SAMPLE_SIZE=5                     sample drafts generated per campaign
# FULL_REVIEW_MAX_RECIPIENTS=25     cap for review mode FULL
# MAX_RECIPIENTS_PER_CAMPAIGN=500   CSV row limit
# CAMPAIGN_MIN_LEAD_TIME_MS=300000  scheduledAt must be at least this far ahead
# CAMPAIGN_FINALIZE_LEAD_MS=120000  finalize job fires this long before scheduledAt
# RECIPIENT_FIELD_MAX_LENGTH=200    max length of first_name/company/role/extra columns
# RECIPIENT_NOTE_MAX_LENGTH=500     max length of note
# AI_INTRO_MAX_CHARS=240            guardrail cap on the generated sentence
# TEMPLATE_BODY_MAX_LENGTH=20000     max characters in a campaign body template
# TEMPLATE_SUBJECT_MAX_LENGTH=300    max characters in a campaign subject template
# AI_INSTRUCTION_MAX_LENGTH=500     max characters in a user AI instruction
# CAMPAIGN_TICK_MS=15000            campaign state reconciliation/completion tick interval (ms, min 1000)
# CAMPAIGN_SENDER_EMAIL="Sendly Scheduler <scheduler@sendly.local>" sender email stored on campaign send jobs
# CAMPAIGN_DELAY_BETWEEN_EMAILS_MS=2000 delay staggered between individual campaign email jobs (ms, min 0)

# ─────────────────────────────────────────────────────────────────────────────
# Tests
#   npm test                    unit tests only — no database, no Redis, no network
#   npm run test:integration    needs a throwaway database and Redis; it creates
#                               and deletes rows, so never point it at data you
#                               care about, and keep the data fake.
#                               1) create an empty DB and apply migrations:
#                                  npx prisma migrate deploy
#                               2) run with the vars below pointing at it
# ─────────────────────────────────────────────────────────────────────────────
# TEST_DATABASE_URL="postgresql://sendly:sendly_pass@localhost:5432/sendly_test?schema=public"
# TEST_REDIS_HOST=localhost
# TEST_REDIS_PORT=6379